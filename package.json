{
  "name": "underdelta",
  "version": "0.1.0",
  "description": "Compile software repositories into evidence-backed visual system models.",
  "type": "module",
  "bin": {
    "underdelta": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run build && node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1"
  }
}
