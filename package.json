{
  "name": "underdelta",
  "version": "0.1.0",
  "description": "Compile software repositories into evidence-backed visual system models.",
  "type": "module",
  "bin": {
    "underdelta": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:extractors": "node --test test/extractors.test.mjs",
    "test:projection": "node --test test/projection.test.mjs test/policy.test.mjs",
    "test:self": "node --test test/self.test.mjs",
    "test:viewer": "npm run build && playwright test",
    "verify": "npm run build && npm run test:extractors && npm run test:projection && npm run test:self",
    "start": "npm run build && node dist/cli.js scan . --serve",
    "scan": "node dist/cli.js scan",
    "inspect": "npm run build && node scripts/inspect.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1"
  }
}
