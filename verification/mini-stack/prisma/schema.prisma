datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  id        String   @id
  status    String
  payments  Payment[]
  createdAt DateTime @default(now())
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  amount  Int
  order   Order  @relation(fields: [orderId], references: [id])
}
